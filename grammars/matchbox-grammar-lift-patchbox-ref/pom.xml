<?xml version="1.0" encoding="UTF-8" ?>
<project
    xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd"
>
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>fr.cnrs.lacito</groupId>
        <artifactId>matchbox</artifactId>
        <version>1.0.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>matchbox-grammar-lift-patchbox-ref</artifactId>
    <version>${revision}</version>
    <packaging>jar</packaging>

    <name>Matchbox LiftPatchRef Grammar</name>
    <description>LiftPatch dictionary commands in the reference syntax (LiftPatchRef), in files of commands only</description>

    <dependencies>
        <dependency>
            <groupId>fr.cnrs.lacito</groupId>
            <artifactId>matchbox-grammar-lift-patchbox-common</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>fr.cnrs.lacito</groupId>
            <artifactId>matchbox-corpus</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>fr.cnrs.lacito</groupId>
            <artifactId>matchbox-grammar-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- From the application, not bundled: the command model and the dictionary model. -->
        <dependency>
            <groupId>io.github.sylvainloiseau</groupId>
            <artifactId>lift-patchbox-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.github.sylvainloiseau</groupId>
            <artifactId>lift-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>fr.cnrs.lacito</groupId>
            <artifactId>matchbox-corpus</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- The plugins directory gets the jar with its dependencies (the LiftPatch parsers and
                 the shared module): a plugin is one jar, loaded by its own class loader. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <copy
                                    file="${project.build.directory}/${project.build.finalName}-jar-with-dependencies.jar"
                                    tofile="${build.root}/plugins/${project.build.finalName}.jar"
                                />
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
