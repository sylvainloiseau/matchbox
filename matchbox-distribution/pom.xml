<?xml version="1.0" encoding="UTF-8" ?>
<project
    xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd"
>
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>fr.cnrs.lacito</groupId>
        <artifactId>matchbox</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>matchbox-distribution</artifactId>
    <version>${revision}</version>
    <packaging>jar</packaging>

    <name>Matchbox Distribution</name>
    <description
    >A distribution package for the Matchbox application</description>

    <dependencies>

        <dependency>
            <groupId>fr.cnrs.lacito</groupId>
            <artifactId>matchbox-gui</artifactId>
        </dependency>

        <dependency>
            <groupId>fr.cnrs.lacito</groupId>
            <artifactId>matchbox-language</artifactId>
        </dependency>

        <dependency>
            <groupId>fr.cnrs.lacito</groupId>
            <artifactId>matchbox-grammar-api</artifactId>
        </dependency>

        <dependency>
            <groupId>fr.cnrs.lacito</groupId>
            <artifactId>matchbox-app</artifactId>

        </dependency>

        <!-- ANTLR Runtime -->
        <dependency>
            <groupId>org.antlr</groupId>
            <artifactId>antlr4-runtime</artifactId>
        </dependency>

        <!-- RichTextFX for editable rich text area -->
        <dependency>
            <groupId>org.fxmisc.richtext</groupId>
            <artifactId>richtextfx</artifactId>
        </dependency>

        <!-- JavaFX -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- ANTLR Maven Plugin -->
            <plugin>
                <groupId>org.antlr</groupId>
                <artifactId>antlr4-maven-plugin</artifactId>
                <version>${antlr.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>antlr4</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <visitor>true</visitor>
                    <listener>true</listener>
                </configuration>
            </plugin>

            <!-- Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
            </plugin>

            <!-- JAR Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass
                            >fr.cnrs.lacito.matchbox.Starter</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <plugin>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass
                            >fr.cnrs.lacito.matchbox.Starter</mainClass>
                        </manifest>
                    </archive>
                    <outputDirectory>${build.root}/assembly</outputDirectory>
                    <descriptors>
                    <descriptor>
                        src/assembly/distribution.xml
                    </descriptor>
                </descriptors>
                    <!-- <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs> -->
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        <plugin>
            <groupId>org.panteleyev</groupId>
            <artifactId>jpackage-maven-plugin</artifactId>
            <version>1.6.0</version>

            <executions>
                <execution>
                    <phase>package</phase>
                    <goals>
                        <goal>jpackage</goal>
                    </goals>
                    <configuration>

                        <!-- App identity -->
                        <name>Matchbox</name>
                        <appVersion>${project.version}</appVersion>
                        <vendor>CNRS-LACITO</vendor>

                        <!-- Main class -->
                        <mainClass>fr.cnrs.lacito.matchbox.Starter</mainClass>

                        <!-- Input: assembled app -->
                        <!-- <input>${build.root}/staging/app-image</input> -->
                        <input>${build.root}/assembly/${project.build.finalName}-distribution</input>
                        <mainJar>app/${project.build.finalName}.jar</mainJar>


                        <!-- Output installer -->
                        <destination>${build.root}/target/installer</destination>

                        <runTimeImage>${build.root}/runtime/jlink-image</runTimeImage>
                        <!-- Type will depend on OS -->
                        <!-- Will be decided automatically according to the OS-->
                        <!--<type>ALL</type>-->

                        <!-- Java options -->
                        <javaOptions>
                            <javaOption>-Dmatchbox.plugins.dir=plugins</javaOption>
                        </javaOptions>

                        <!-- Optional icon -->
                        <icon>${project.basedir}/src/main/resources/icon.icns</icon>

                    </configuration>
                </execution>
            </executions>
        </plugin>
        </plugins>
    </build>
</project>
