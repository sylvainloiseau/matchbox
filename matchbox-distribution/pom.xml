<?xml version="1.0" encoding="UTF-8" ?>
<project
    xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd"
>
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>fr.cnrs.lacito</groupId>
        <artifactId>matchbox</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>matchbox-distribution</artifactId>
    <version>${revision}</version>
    <packaging>jar</packaging>

    <name>Matchbox Distribution</name>
    <description
    >A distribution package for the Matchbox application</description>

    <dependencies>

        <dependency>
            <groupId>fr.cnrs.lacito</groupId>
            <artifactId>matchbox-gui</artifactId>
        </dependency>

        <dependency>
            <groupId>fr.cnrs.lacito</groupId>
            <artifactId>matchbox-corpus</artifactId>
        </dependency>

        <dependency>
            <groupId>fr.cnrs.lacito</groupId>
            <artifactId>matchbox-grammar-api</artifactId>
        </dependency>

        <dependency>
            <groupId>fr.cnrs.lacito</groupId>
            <artifactId>matchbox-grammar-fx</artifactId>
        </dependency>
        <dependency>
            <groupId>fr.cnrs.lacito</groupId>
            <artifactId>matchbox-app</artifactId>
        </dependency>
        <dependency>
            <groupId>fr.cnrs.lacito</groupId>
            <artifactId>matchbox-assist</artifactId>
        </dependency>

        <!-- ANTLR Runtime -->
        <dependency>
            <groupId>org.antlr</groupId>
            <artifactId>antlr4-runtime</artifactId>
        </dependency>

        <!-- RichTextFX for editable rich text area -->
        <dependency>
            <groupId>org.fxmisc.richtext</groupId>
            <artifactId>richtextfx</artifactId>
        </dependency>

        <!-- JavaFX -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>win</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <configuration>
                            <icon>${project.basedir}/src/main/resources/icon.ico</icon>
                            <winMenu>true</winMenu>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>mac</id>
            <activation>
                <os>
                    <family>mac</family>
                </os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <configuration>
                            <icon>${project.basedir}/src/main/resources/icon.icns</icon>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>linux</id>
            <activation>
                <os>
                    <family>linux</family>
                </os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <configuration>
                            <icon>${project.basedir}/src/main/resources/icon.png</icon>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <plugins>
            <!-- ANTLR Maven Plugin -->
            <plugin>
                <groupId>org.antlr</groupId>
                <artifactId>antlr4-maven-plugin</artifactId>
                <version>${antlr.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>antlr4</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <visitor>true</visitor>
                    <listener>true</listener>
                </configuration>
            </plugin>

            <!-- Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
            </plugin>

            <!-- JAR Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass
                            >fr.cnrs.lacito.matchbox.Starter</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <plugin>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass
                            >fr.cnrs.lacito.matchbox.Starter</mainClass>
                        </manifest>
                    </archive>
                    <outputDirectory>${build.root}/assembly</outputDirectory>
                    <descriptors>
                    <descriptor>
                        src/assembly/distribution.xml
                    </descriptor>
                </descriptors>
                    <!-- <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs> -->
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
              <artifactId>maven-clean-plugin</artifactId>
              <version>3.5.0</version>
              <configuration>
                <filesets>
                  <fileset>
                    <directory>../build/target</directory>
                  </fileset>
                  <fileset>
                    <directory>${build.root}/assembly</directory>
                  </fileset>
                </filesets>
              </configuration>
              <executions>
                <!-- The assembly is a directory that is not emptied between builds: jars
                     of removed or renamed modules would stay in lib/ and be packaged by
                     jpackage. Empty it at the start of every build, not only on mvn clean. -->
                <execution>
                  <id>clean-assembly</id>
                  <phase>initialize</phase>
                  <goals>
                    <goal>clean</goal>
                  </goals>
                  <configuration>
                    <excludeDefaultDirectories>true</excludeDefaultDirectories>
                    <filesets>
                      <fileset>
                        <directory>${build.root}/assembly</directory>
                      </fileset>
                    </filesets>
                  </configuration>
                </execution>
              </executions>
            </plugin>
        <plugin>
            <groupId>org.panteleyev</groupId>
            <artifactId>jpackage-maven-plugin</artifactId>
            <version>1.6.0</version>

            <executions>
                <execution>
                    <phase>package</phase>
                    <goals>
                        <goal>jpackage</goal>
                    </goals>
                    <configuration>

                        <!-- App identity -->
                        <name>Matchbox</name>
                        <appVersion>${project.version}</appVersion>
                        <vendor>CNRS-LACITO</vendor>

                        <!-- Main class -->
                        <mainClass>fr.cnrs.lacito.matchbox.Starter</mainClass>

                        <!-- Input: assembled app -->
                        <!-- <input>${build.root}/staging/app-image</input> -->
                        <input>${build.root}/assembly/${project.build.finalName}-distribution</input>
                        <mainJar>app/${project.build.finalName}.jar</mainJar>


                        <!-- Output installer -->
                        <destination>${build.root}/target/installer</destination>

                        <!-- Java runtime of the installer: jpackage runs jlink with these JDK
                             modules only (JavaFX and the other libraries stay as jars in the
                             application). The list comes from jdeps on the assembled jars:
                               jdeps -q -ignore-missing-deps -print-module-deps -class-path ...
                             Add a module here when a new dependency needs one, otherwise the
                             installed application fails with NoClassDefFoundError. -->
                        <addModules>
                            <addModule>java.base</addModule>
                            <addModule>java.desktop</addModule>      <!-- JavaFX -->
                            <addModule>java.logging</addModule>      <!-- log files -->
                            <addModule>java.xml</addModule>          <!-- .mbx project files, FXML -->
                            <addModule>java.scripting</addModule>    <!-- JavaFX (FXML) -->
                            <addModule>java.sql</addModule>          <!-- Jackson -->
                            <addModule>java.net.http</addModule>     <!-- AI assistant: HTTP clients of the providers -->
                            <addModule>jdk.unsupported</addModule>   <!-- JavaFX, RichTextFX -->
                            <addModule>jdk.jfr</addModule>           <!-- required by a library (jdeps) -->
                            <addModule>jdk.charsets</addModule>      <!-- all charsets offered in the settings -->
                            <addModule>jdk.localedata</addModule>    <!-- locales other than English -->
                        </addModules>
                        <!-- Type will depend on OS -->
                        <!-- Will be decided automatically according to the OS-->
                        <!--<type>ALL</type>-->

                        <!-- Java options -->
                        <javaOptions>
                            <!-- $APPDIR is expanded by the jpackage launcher to the application
                                 directory; a relative path would be resolved against the working
                                 directory, which is / when the app is started from the Finder -->
                            <javaOption>-Dmatchbox.plugins.dir=$APPDIR/plugins</javaOption>
                        </javaOptions>


                    </configuration>
                </execution>
            </executions>
        </plugin>
        </plugins>
    </build>
</project>
