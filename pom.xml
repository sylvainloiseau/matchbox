<?xml version="1.0" encoding="UTF-8" ?>
<project
    xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd"
>
    <modelVersion>4.0.0</modelVersion>

    <groupId>fr.cnrs.lacito</groupId>
    <artifactId>matchbox</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>Matchbox</name>
    <description
    >A JavaFX application for parsing notebook text and building linguistic corpora</description>

    <modules>
        <module>grammars/matchbox-grammar-notebook</module>
        <module>grammars/matchbox-grammar-lex</module>
        <module>grammars/matchbox-grammar-conll</module>
        <module>matchbox-corpus</module>
        <module>matchbox-gui</module>
        <module>matchbox-grammar-api</module>
        <module>matchbox-app</module>
        <module>matchbox-distribution</module>
    </modules>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>23.0.2</javafx.version>
        <antlr.version>4.13.1</antlr.version>
        <revision>1.0.0</revision>
        <plugins.dir>${project.basedir}/plugins</plugins.dir>
        <build.root>${maven.multiModuleProjectDirectory}/build</build.root>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>fr.cnrs.lacito</groupId>
                <artifactId>matchbox-gui</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>fr.cnrs.lacito</groupId>
                <artifactId>matchbox-corpus</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>fr.cnrs.lacito</groupId>
                <artifactId>matchbox-grammar-api</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>fr.cnrs.lacito</groupId>
                <artifactId>matchbox-app</artifactId>
                <version>${revision}</version>
            </dependency>
            <!-- ANTLR Runtime -->
            <dependency>
                <groupId>org.antlr</groupId>
                <artifactId>antlr4-runtime</artifactId>
                <version>${antlr.version}</version>
            </dependency>
            <!-- RichTextFX for editable rich text area -->
            <dependency>
                <groupId>org.fxmisc.richtext</groupId>
                <artifactId>richtextfx</artifactId>
                <version>0.11.7</version>
            </dependency>
            <!-- JavaFX -->
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-base</artifactId>
                <version>${javafx.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-controls</artifactId>
                <version>${javafx.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-fxml</artifactId>
                <version>${javafx.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-graphics</artifactId>
                <version>${javafx.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>

            <!-- Compiler Plugin -->
            <!-- <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
            </plugin> -->

            <!-- JAR Plugin -->
            <!-- <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass
                            >fr.cnrs.lacito.matchbox.MatchboxApplication</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin> -->

        </plugins>
    </build>
</project>
