<?xml version="1.0" encoding="UTF-8" ?>
<project
    xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd"
>
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>fr.cnrs.lacito</groupId>
        <artifactId>matchbox</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>matchbox-gui</artifactId>
    <version>${revision}</version>
    <packaging>jar</packaging>

    <name>Matchbox GUI</name>
    <description
    >A JavaFX GUI app for the matchbox application, used for parsing notebook text and building linguistic corpora</description>

    <dependencies>
        <dependency>
            <groupId>fr.cnrs.lacito</groupId>
            <artifactId>matchbox-corpus</artifactId>
        </dependency>
        <dependency>
            <groupId>fr.cnrs.lacito</groupId>
            <artifactId>matchbox-grammar-api</artifactId>
        </dependency>
        <dependency>
            <groupId>fr.cnrs.lacito</groupId>
            <artifactId>matchbox-grammar-fx</artifactId>
        </dependency>
        <dependency>
            <groupId>fr.cnrs.lacito</groupId>
            <artifactId>matchbox-app</artifactId>
        </dependency>
        <dependency>
            <groupId>fr.cnrs.lacito</groupId>
            <artifactId>matchbox-assist</artifactId>
        </dependency>
        <!-- real grammars for the tests of view editing -->
        <dependency>
            <groupId>fr.cnrs.lacito</groupId>
            <artifactId>matchbox-grammar-markdownheading</artifactId>
            <version>${revision}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>fr.cnrs.lacito</groupId>
            <artifactId>matchbox-grammar-notebook</artifactId>
            <version>${revision}</version>
            <scope>test</scope>
        </dependency>
        <!-- RichTextFX for editable rich text area -->
        <dependency>
            <groupId>org.fxmisc.richtext</groupId>
            <artifactId>richtextfx</artifactId>
        </dependency>
        <!-- JavaFX -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-media</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
            </plugin>
            <!-- JAR Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass
                            >fr.cnrs.lacito.matchbox.MatchboxApplication</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <!-- JavaFX Maven Plugin for running the application -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass
                    >fr.cnrs.lacito.matchbox.MatchboxApplication</mainClass>
                    <options>
                        <option>-Dmatchbox.plugins.dir=../build/plugins</option>
                    </options>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
