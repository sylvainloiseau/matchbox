<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<SplitPane dividerPositions="0.25" style="-fx-background-color: #cccccc;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1">
  <VBox style="-fx-background-color: #cccccc;">
      <Label style="-fx-font-weight: bold; -fx-padding: 5;" text="Files" />
      <TextField fx:id="filterFileTextField" promptText="Filter" />
      <ListView fx:id="fileListView" VBox.vgrow="ALWAYS" />
  </VBox>
  <SplitPane fx:id="topSplitPane" dividerPositions="0.5" orientation="VERTICAL">
    <VBox style="-fx-background-color: #cccccc;">
        <ToolBar prefHeight="40.0" prefWidth="200.0">
          <items>
            <Button fx:id="saveButton" mnemonicParsing="false" onAction="#handleSaveCurrentFile" text="Save" />
            <Button fx:id="parseButton" mnemonicParsing="false" onAction="#handleParseText" text="Parse" />
            <Button fx:id="closeButton" mnemonicParsing="false" onAction="#handleCloseFile" text="Close" />
          <Button mnemonicParsing="false" text="Insert intermorphemic gloss bloc" />
          </items>
        </ToolBar>
        <org.fxmisc.richtext.InlineCssTextArea fx:id="fileContentCodeArea" VBox.vgrow="ALWAYS" />
    </VBox>
    <VBox style="-fx-border-color: #cccccc;">
      <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <tabs>
          <Tab text="Objects">
            <content>
              <SplitPane fx:id="objectsSplitPane" dividerPositions="0.55" orientation="VERTICAL">
                <TabPane fx:id="objectKindTabPane" tabClosingPolicy="UNAVAILABLE" />
                <ScrollPane fx:id="objectDetailPane" fitToWidth="true" fitToHeight="true" />
              </SplitPane>
            </content>
          </Tab>
          <Tab text="Session">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" />
            </content>
          </Tab>
          <Tab text="Tag">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" />
            </content>
          </Tab>
          <Tab fx:id="parsingErrorPane" text="Parsing error">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                <children>
                  <TableView fx:id="errorTableView" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <columns>
                      <TableColumn fx:id="lineColumn" prefWidth="60" text="Line" />
                      <TableColumn fx:id="charPositionColumn" prefWidth="80" text="Position" />
                      <TableColumn fx:id="messageColumn" prefWidth="600" text="Message" />
                    </columns>
                  </TableView>
                </children>
              </AnchorPane>
            </content>
          </Tab>
        </tabs>
      </TabPane>
    </VBox>
  </SplitPane>
</SplitPane>
