<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<SplitPane dividerPositions="0.25" style="-fx-background-color: #cccccc;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1">
  <VBox style="-fx-background-color: #cccccc;">
      <Label style="-fx-font-weight: bold; -fx-padding: 5;" text="Files" />
      <TextField fx:id="filterFileTextField" promptText="Filter" />
      <ListView fx:id="fileListView" VBox.vgrow="ALWAYS" />
  </VBox>
  <SplitPane fx:id="topSplitPane" dividerPositions="0.5" orientation="VERTICAL">
    <VBox style="-fx-background-color: #cccccc;">
        <ToolBar prefHeight="40.0" prefWidth="200.0">
          <items>
            <Button fx:id="saveButton" mnemonicParsing="false" onAction="#handleSaveCurrentFile" text="Save" />
            <Button fx:id="parseButton" mnemonicParsing="false" onAction="#handleParseText" text="Parse" />
            <Button fx:id="closeButton" mnemonicParsing="false" onAction="#handleCloseFile" text="Close" />
          <Button mnemonicParsing="false" text="Insert intermorphemic gloss bloc" />
          </items>
        </ToolBar>
        <org.fxmisc.richtext.InlineCssTextArea fx:id="fileContentCodeArea" VBox.vgrow="ALWAYS" />
    </VBox>
    <VBox style="-fx-border-color: #cccccc;">
      <TabPane tabClosingPolicy="UNAVAILABLE">
        <tabs>
          <Tab text="Interlinear examples">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0">
                <children>
                  <TableView fx:id="igtTableView" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <columns>
                      <TableColumn fx:id="transcriptionCol" prefWidth="200" text="Transcription" />
                      <TableColumn fx:id="glossCol" prefWidth="200" text="Morphemic glosses" />
                      <TableColumn fx:id="translationCol" prefWidth="200" text="Translation" />
                    </columns>
                  </TableView>
                </children>
              </AnchorPane>
            </content>
          </Tab>
          <Tab text="Lexical information">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                <children>
                  <ScrollPane prefHeight="200.0" prefWidth="200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <content>
                      <AnchorPane minHeight="0.0" minWidth="0.0">
                        <children>
                          <VBox fx:id="lexicalInformationBoxes" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
                        </children>
                      </AnchorPane>
                    </content>
                  </ScrollPane>
                </children>
              </AnchorPane>
            </content>
          </Tab>
          <Tab text="Session">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" />
            </content>
          </Tab>
          <Tab text="Tag">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" />
            </content>
          </Tab>
          <Tab fx:id="parsingErrorPane" text="Parsing error">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                <children>
                  <TableView fx:id="errorTableView" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <columns>
                      <TableColumn fx:id="lineColumn" prefWidth="200" text="Transcription" />
                      <TableColumn fx:id="charPositionColumn" prefWidth="200" text="Morphemic glosses" />
                      <TableColumn fx:id="messageColumn" prefWidth="200" text="Translation" />
                    </columns>
                  </TableView>
                </children>
              </AnchorPane>
            </content>
          </Tab>
        </tabs>
      </TabPane>
    </VBox>
  </SplitPane>
</SplitPane>
