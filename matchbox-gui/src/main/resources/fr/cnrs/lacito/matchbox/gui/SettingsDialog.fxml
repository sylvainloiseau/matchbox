<?xml version="1.0" encoding="UTF-8" ?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox
    spacing="10.0"
    xmlns="http://javafx.com/javafx/8.0.171"
    xmlns:fx="http://javafx.com/fxml/1"
>
  <children>
    <TabPane fx:id="tabs">
      <tabs>
        <Tab text="Grammar" closable="false">
          <content>
            <VBox spacing="10.0" style="-fx-padding: 15;">
              <children>
                <Label
                                    text="Morpheme separators (characters):"
                                    style="-fx-font-weight: bold;"
                                />
                <TextField fx:id="separatorsField" promptText="e.g. -,/" />
              </children>
            </VBox>
          </content>
        </Tab>
        <Tab text="Files" closable="false">
          <content>
            <VBox spacing="8.0" style="-fx-padding: 15;">
              <children>
                <Label
                                    text="Charset of the text files:"
                                    style="-fx-font-weight: bold;"
                                />
                <ComboBox fx:id="charsetComboBox" editable="true" />
                <Label
                                    text="Applies to files opened afterwards; open files keep their charset."
                                    wrapText="true"
                                    style="-fx-font-size: 0.9em; -fx-text-fill: #666666;"
                                />
                <Label
                                    text="Default file extensions of new directories (one per line; empty: all files). Each directory then has its own patterns (Directory settings, in File Mode):"
                                    wrapText="true"
                                    style="-fx-font-weight: bold;"
                                />
                <TextArea
                                    fx:id="fileExtensionsArea"
                                    prefRowCount="2"
                                />
                <Label
                                    text="File patterns (one per line):"
                                    style="-fx-font-weight: bold;"
                                />
                <TextArea fx:id="filePatternsArea" prefRowCount="2" />
              </children>
            </VBox>
          </content>
        </Tab>
        <Tab text="Editor" closable="false">
          <content>
            <VBox spacing="10.0" style="-fx-padding: 15;">
              <children>
                <CheckBox fx:id="wrapLinesCheckBox" text="Wrap lines" />
                <CheckBox fx:id="lineNumbersCheckBox" text="Show line numbers" />
                <CheckBox fx:id="highlightCurrentLineCheckBox" text="Highlight the current line" />
                <CheckBox fx:id="showInvisiblesCheckBox" text="Show invisible characters (tabs, trailing spaces)" />
                <CheckBox fx:id="autoIndentCheckBox" text="Enter keeps the indentation of the line" />
                <Label text="Font size (8–40):" style="-fx-font-weight: bold;" />
                <TextField fx:id="fontSizeField" promptText="13" />
                <Label text="Font family:" style="-fx-font-weight: bold;" />
                <ComboBox fx:id="fontFamilyComboBox" />
                <Label
                                    text="A proportional font breaks the alignment of interlinear glosses."
                                    wrapText="true"
                                    style="-fx-font-size: 0.9em; -fx-text-fill: #666666;"
                                />
              </children>
            </VBox>
          </content>
        </Tab>
        <Tab text="Application" closable="false">
          <content>
            <VBox spacing="10.0" style="-fx-padding: 15;">
              <children>
                <Label
                                    text="Maximum number of recent files to record:"
                                    style="-fx-font-weight: bold;"
                                />
                <TextField fx:id="recentFilesLimitField" promptText="e.g. 10" />
                <Label
                                    text="Maximum number of recent projects to record:"
                                    style="-fx-font-weight: bold;"
                                />
                <TextField fx:id="recentProjectsLimitField" promptText="e.g. 10" />
                <Label
                                    text="Reopen last project ?"
                                    style="-fx-font-weight: bold;"
                                />
                <CheckBox fx:id="openLastProjectCheckBox" />
                <Label
                                    text="Edits in object views"
                                    style="-fx-font-weight: bold;"
                                />
                <CheckBox
                                    fx:id="allowInvalidViewEditsCheckBox"
                                    text="Apply edits that add parse errors (by default they are refused)"
                                />
              </children>
            </VBox>
          </content>
        </Tab>
      </tabs>
    </TabPane>
    <Separator />
    <HBox
            spacing="10.0"
            style="-fx-alignment: center-right; -fx-padding: 0 5 5 5;"
        >
      <children>
        <Button fx:id="okButton" text="OK" prefWidth="80.0" />
        <Button fx:id="cancelButton" text="Cancel" prefWidth="80.0" />
      </children>
    </HBox>
  </children>
</VBox>
