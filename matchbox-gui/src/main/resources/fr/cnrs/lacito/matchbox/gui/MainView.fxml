<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.input.KeyCodeCombination?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<VBox fx:id="mainBorderPane" style="-fx-background-color: #cccccc;" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1">
        <MenuBar VBox.vgrow="NEVER">
            <Menu fx:id="fileMenu" text="File">
            <items>
               <MenuItem fx:id="createProjectMenuItem" mnemonicParsing="true" onAction="#handleCreateProject" text="Create project..." />
               <MenuItem fx:id="openFilesetMenuItem" mnemonicParsing="true" onAction="#handleOpenFileset" text="Open fileset" />
            <Menu fx:id="openRecentProjectsMenuItem" mnemonicParsing="false" onAction="#handleOpenRecentFileset" text="Open recent project">
              <items>
                <MenuItem mnemonicParsing="false" text="Action 1" />
              </items>
            </Menu>
            <MenuItem fx:id="saveFilesetMenuItem" mnemonicParsing="false" text="Save fileset" />
            <MenuItem fx:id="saveFilesetAsMenuItem" mnemonicParsing="false" text="Save fileset as..." />
               <MenuItem fx:id="closeCurrentFilesetMenuItem" mnemonicParsing="true" onAction="#handleCloseCurrentFileset" text="Close current fileset" />
            <SeparatorMenuItem mnemonicParsing="false" />

               <MenuItem fx:id="openFileMenu" mnemonicParsing="true" onAction="#handleOpenFileWithFileChooser" text="Add _File">
                  <accelerator>
                     <KeyCodeCombination alt="UP" code="O" control="ANY" meta="UP" shift="UP" shortcut="UP" />
                  </accelerator>
               </MenuItem>
               <MenuItem fx:id="openDirItem" mnemonicParsing="true" onAction="#handleOpenDirectory" text="Add files in _Directory" />
               <Menu fx:id="openRecentMenu" mnemonicParsing="false" text="Add recent">
                 <items>
                   <MenuItem mnemonicParsing="false" text="Action 1" />
                 </items>
               </Menu>
               <MenuItem fx:id="saveCurrentFileMenuItem" onAction="#handleSaveCurrentFile" text="_Save current file" />
               <MenuItem fx:id="closeFileMenuItem" mnemonicParsing="true" onAction="#handleCloseFile" text="_Close file" />
               <MenuItem fx:id="closeAllFilesItem" mnemonicParsing="true" onAction="#handleCloseAllFiles" text="Close all file" />
            <SeparatorMenuItem mnemonicParsing="false" />
               <MenuItem fx:id="settingsItem" mnemonicParsing="false" onAction="#handleSettings" text="Settings" />
               <MenuItem fx:id="quitItem" mnemonicParsing="false" onAction="#handleQuit" text="Quit">
                  <accelerator>
                     <KeyCodeCombination alt="ANY" code="Q" control="UP" meta="UP" shift="UP" shortcut="UP" />
                  </accelerator>
               </MenuItem>
            </items></Menu>
              <Menu fx:id="editMenu" text="Edit">
                <items>
                  <MenuItem fx:id="undoMenuItem" mnemonicParsing="false" onAction="#handleUndoMenuItem" text="Undo" />
                  <MenuItem fx:id="redoMenuItem" mnemonicParsing="false" onAction="#handleRedoMenuItem" text="Redo" />
                  <MenuItem fx:id="searchMenuItem" mnemonicParsing="false" onAction="#handleSearchMenuItem" text="Search" />
                </items>
              </Menu>
      <Menu mnemonicParsing="false" text="Insert">
        <items>
          <MenuItem mnemonicParsing="false" text="Insert intermorphemic gloss" />
            <MenuItem mnemonicParsing="false" text="Insert lexical information" />
        </items>
      </Menu>
            <Menu fx:id="exportMenu" text="Export">
              <items>
                <MenuItem fx:id="exportMenuDictionary" mnemonicParsing="true" onAction="#handleOpenFileWithFileChooser" text="Export Dictionary" />
              </items>
            </Menu>
        </MenuBar>
        <ToolBar maxHeight="40.0" minHeight="40.0" prefHeight="40.0" prefWidth="200.0" VBox.vgrow="NEVER">
          <items>
          <fx:define>
               <ToggleGroup fx:id="viewToggleGroup">
               </ToggleGroup>
            </fx:define>
         <ToggleButton fx:id="fileModeToggleButton" mnemonicParsing="false" selected="true" text="File Mode">
            <toggleGroup>
               <ToggleGroup fx:id="viewToggleGroup" />
            </toggleGroup></ToggleButton>
         <ToggleButton fx:id="corpusViewToggleButton" mnemonicParsing="false" prefHeight="25.0" prefWidth="90.0" text="Corpus View" toggleGroup="$viewToggleGroup">
            </ToggleButton>
         <ToggleButton fx:id="tagViewToggleButton" mnemonicParsing="false" prefHeight="25.0" prefWidth="82.0" text="Tag View" toggleGroup="$viewToggleGroup" />
          </items>
        </ToolBar>
   <AnchorPane fx:id="viewPane" VBox.vgrow="ALWAYS" />
   <HBox id="HBox" alignment="CENTER_LEFT" maxHeight="14.0" minHeight="14.0" prefHeight="14.0" spacing="5.0" VBox.vgrow="NEVER">
      <children>
         <Label maxHeight="1.7976931348623157E308" maxWidth="-1.0" text="Left status" HBox.hgrow="ALWAYS">
            <font>
               <Font size="11.0" fx:id="x3" />
            </font>
            <textFill>
               <Color red="0.625" green="0.625" blue="0.625" fx:id="x4" />
            </textFill>
         </Label>
         <Pane prefHeight="-1.0" prefWidth="-1.0" HBox.hgrow="ALWAYS" />
         <Label fx:id="statusBarRightLabel" font="$x3" maxHeight="14.0" maxWidth="-1.0" minHeight="14.0" prefHeight="14.0" prefWidth="295.0" textFill="#0d0000" HBox.hgrow="NEVER" />
      </children>
      <padding>
         <Insets bottom="3.0" left="3.0" right="3.0" top="3.0" />
      </padding>
   </HBox>
</VBox>
