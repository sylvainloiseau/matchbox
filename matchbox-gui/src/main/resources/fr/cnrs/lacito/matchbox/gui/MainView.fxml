<?xml version="1.0" encoding="UTF-8" ?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.input.KeyCodeCombination?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<VBox
    fx:id="mainBorderPane"
    style="-fx-background-color: #cccccc;"
    xmlns="http://javafx.com/javafx/19"
    xmlns:fx="http://javafx.com/fxml/1"
>
        <MenuBar fx:id="menuBar" VBox.vgrow="NEVER">
            <!-- File: the project file and the application; Current project: the project's content -->
            <Menu fx:id="fileMenu" text="File">
            <items>
               <MenuItem
                    fx:id="newProjectMenuItem"
                    onAction="#handleNewProject"
                    text="_New project"
                >
                  <accelerator>
                     <KeyCodeCombination alt="UP" code="N" control="UP" meta="UP" shift="UP" shortcut="DOWN" />
                  </accelerator>
               </MenuItem>
               <MenuItem
                    fx:id="openProjectMenuItem"
                    onAction="#handleOpenProject"
                    text="_Open project…"
                >
                  <accelerator>
                     <KeyCodeCombination alt="UP" code="O" control="UP" meta="UP" shift="UP" shortcut="DOWN" />
                  </accelerator>
               </MenuItem>
               <Menu
                    fx:id="openRecentProjectsMenuItem"
                    mnemonicParsing="false"
                    text="Open recent project"
                >
                 <items>
                   <MenuItem mnemonicParsing="false" text="No recent projects" />
                 </items>
               </Menu>
               <SeparatorMenuItem mnemonicParsing="false" />
               <MenuItem
                    fx:id="saveProjectMenuItem"
                    mnemonicParsing="false"
                    onAction="#handleSaveCurrentProject"
                    text="Save project"
                />
               <MenuItem
                    fx:id="saveAsProjectMenuItem"
                    mnemonicParsing="false"
                    onAction="#handleSaveAsProject"
                    text="Save project as…"
                />
               <MenuItem
                    fx:id="closeCurrentProjectMenuItem"
                    mnemonicParsing="false"
                    onAction="#handleCloseCurrentProject"
                    text="Close project"
                >
                  <accelerator>
                     <KeyCodeCombination alt="UP" code="W" control="UP" meta="UP" shift="UP" shortcut="DOWN" />
                  </accelerator>
               </MenuItem>
               <SeparatorMenuItem mnemonicParsing="false" />
               <MenuItem
                    fx:id="settingsItem"
                    mnemonicParsing="false"
                    onAction="#handleSettings"
                    text="Settings…"
                >
                  <accelerator>
                     <KeyCodeCombination alt="UP" code="COMMA" control="UP" meta="UP" shift="UP" shortcut="DOWN" />
                  </accelerator>
               </MenuItem>
               <MenuItem
                    fx:id="quitItem"
                    mnemonicParsing="false"
                    onAction="#handleQuit"
                    text="Quit"
                >
                  <accelerator>
                     <KeyCodeCombination alt="ANY" code="Q" control="UP" meta="UP" shift="UP" shortcut="UP" />
                  </accelerator>
               </MenuItem>
            </items></Menu>
            <Menu fx:id="currentProjectMenu" text="Current project">
            <items>
               <MenuItem
                    fx:id="editProjectMenuItem"
                    mnemonicParsing="false"
                    onAction="#handleEditProject"
                    text="Project properties…"
                />
               <SeparatorMenuItem mnemonicParsing="false" />
               <MenuItem
                    fx:id="openFileMenu"
                    mnemonicParsing="true"
                    onAction="#handleOpenFileWithFileChooser"
                    text="Add _file…"
                />
               <MenuItem
                    fx:id="openDirItem"
                    mnemonicParsing="true"
                    onAction="#handleOpenDirectory"
                    text="Add files in _directory…"
                />
               <Menu
                    fx:id="openRecentMenu"
                    mnemonicParsing="false"
                    text="Add recent"
                >
                 <items>
                   <MenuItem mnemonicParsing="false" text="No recent files" />
                 </items>
               </Menu>
               <SeparatorMenuItem mnemonicParsing="false" />
               <MenuItem
                    fx:id="saveCurrentFileMenuItem"
                    onAction="#handleSaveCurrentFile"
                    text="_Save current file"
                >
                  <accelerator>
                     <KeyCodeCombination alt="UP" code="S" control="UP" meta="UP" shift="UP" shortcut="DOWN" />
                  </accelerator>
               </MenuItem>
               <MenuItem
                    fx:id="saveAllFilesMenuItem"
                    mnemonicParsing="false"
                    onAction="#handleSaveAllFiles"
                    text="Save all files"
                >
                  <accelerator>
                     <KeyCodeCombination alt="UP" code="S" control="UP" meta="UP" shift="DOWN" shortcut="DOWN" />
                  </accelerator>
               </MenuItem>
               <SeparatorMenuItem mnemonicParsing="false" />
               <MenuItem
                    fx:id="removeFileMenuItem"
                    mnemonicParsing="false"
                    onAction="#handleRemoveFile"
                    text="Remove file from project"
                />
               <MenuItem
                    fx:id="removeDirectoryMenuItem"
                    mnemonicParsing="false"
                    onAction="#handleRemoveDirectory"
                    text="Remove directory from project…"
                />
               <MenuItem
                    fx:id="removeAllFilesMenuItem"
                    mnemonicParsing="false"
                    onAction="#handleRemoveAllFiles"
                    text="Remove all files from project…"
                />
            </items></Menu>
              <Menu fx:id="editMenu" text="Edit">
                <items>
                  <MenuItem
                    fx:id="undoMenuItem"
                    mnemonicParsing="false"
                    onAction="#handleUndoMenuItem"
                    text="Undo"
                />
                  <MenuItem
                    fx:id="redoMenuItem"
                    mnemonicParsing="false"
                    onAction="#handleRedoMenuItem"
                    text="Redo"
                />
                  <MenuItem
                    fx:id="playSegmentMenuItem"
                    mnemonicParsing="false"
                    onAction="#handlePlaySegmentMenuItem"
                    text="Play media segment (⇧⌘Space)"
                />
                </items>
              </Menu>
              <!-- the modes are listed first (ModeHost); the active mode's menu follows this menu -->
              <Menu fx:id="modeMenu" text="Mode">
                <items>
                  <SeparatorMenuItem mnemonicParsing="false" />
                  <MenuItem
                    fx:id="backMenuItem"
                    mnemonicParsing="false"
                    onAction="#handleBack"
                    text="Back"
                />
                  <MenuItem
                    fx:id="forwardMenuItem"
                    mnemonicParsing="false"
                    onAction="#handleForward"
                    text="Forward"
                />
                </items>
              </Menu>
            <Menu fx:id="assistantMenu" text="Assistant">
              <items>
                <MenuItem
                    fx:id="refreshExamplesItem"
                    mnemonicParsing="false"
                    onAction="#handleRefreshExamples"
                    text="Refresh project examples"
                />
                <SeparatorMenuItem mnemonicParsing="false" />
                <MenuItem
                    mnemonicParsing="false"
                    onAction="#handleAiAssistant"
                    text="AI assistant settings…"
                />
              </items>
            </Menu>
            <Menu fx:id="exportMenu" text="Export">
              <items>
                <MenuItem
                    fx:id="exportMenuDictionary"
                    mnemonicParsing="true"
                    onAction="#handleExportDictionary"
                    text="Export Dictionary"
                />
              </items>
            </Menu>
        </MenuBar>
        <!-- Back/Forward, then one button per mode (ModeHost) -->
        <ToolBar
        fx:id="toolBar"
        maxHeight="40.0"
        minHeight="40.0"
        prefHeight="40.0"
        prefWidth="200.0"
        VBox.vgrow="NEVER"
    >
          <items>
            <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleBack" text="◀" />
            <Button fx:id="forwardButton" mnemonicParsing="false" onAction="#handleForward" text="▶" />
            <Separator orientation="VERTICAL" />
          </items>
        </ToolBar>
   <!-- the active mode (viewPane), or the start page while no project is open (MainController) -->
   <StackPane fx:id="mainArea" VBox.vgrow="ALWAYS">
      <AnchorPane fx:id="viewPane" />
   </StackPane>
   <!-- status bar: messages of the status line (left), focus and assistant status (right) -->
   <HBox
        id="HBox"
        alignment="CENTER_LEFT"
        maxHeight="18.0"
        minHeight="18.0"
        prefHeight="18.0"
        spacing="5.0"
        style="-fx-padding: 0 4 0 4;"
        VBox.vgrow="NEVER"
    >
      <children>
         <Label fx:id="statusMessageLabel" style="-fx-font-size: 11;" />
         <Hyperlink fx:id="statusLink" style="-fx-font-size: 11; -fx-padding: 0;" />
         <Pane prefHeight="-1.0" prefWidth="-1.0" HBox.hgrow="ALWAYS" />
         <Label fx:id="focusLabel" style="-fx-font-size: 11; -fx-text-fill: #555555;" />
         <Hyperlink fx:id="assistStatusLink" style="-fx-font-size: 11; -fx-padding: 0;" />
      </children>
   </HBox>
</VBox>
